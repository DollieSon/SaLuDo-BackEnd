{
  "name": "saludo-backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "build": "tsc",
    "start": "npx tsc && node dist/index.js",
    "dev": "nodemon --exec ts-node index.ts",
    "dev:local": "concurrently \"nodemon --exec ts-node -r dotenv/config index.ts dotenv_config_path=.env.local\" \"ts-node -r dotenv/config email-worker.ts dotenv_config_path=.env.local\"",
    "dev:remote": "nodemon --exec \"ts-node -r dotenv/config index.ts dotenv_config_path=.env.production\"",
    "start:local": "npx tsc && node -r dotenv/config dist/index.js dotenv_config_path=.env.local",
    "start:remote": "npx tsc && node -r dotenv/config dist/index.js dotenv_config_path=.env.production",
    "worker:local": "ts-node -r dotenv/config email-worker.ts dotenv_config_path=.env.local",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.81.5",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "handlebars": "^4.7.10",
    "helmet": "^8.3.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^6.16.0",
    "multer": "^2.5.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^10.3.1",
    "pdf-parse": "^2.4.5",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.2",
    "@types/handlebars": "^4.1.0",
    "@types/mongodb": "^4.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.15.29",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.2",
    "@types/sanitize-html": "^2.16.0",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.2.1",
    "mongodb-memory-server": "^10.4.3",
    "nodemon": "^3.0.2",
    "supertest": "^7.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "vitest": "^5.0.5"
  }
}
