# Copy to .env.local (local) or set in the Render dashboard (production).
# Never commit real values.

# ---- Required in every environment (the server refuses to start without it)
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
# Optional but recommended: separate key for refresh tokens (must differ from JWT_SECRET).
# If unset, a separate key is derived from JWT_SECRET.
JWT_REFRESH_SECRET=

# ---- Required
MONGO_URI=mongodb://admin:password@localhost:27017/?authSource=admin
GOOGLE_API_KEY=

# ---- Required in production: frontend origin(s), comma-separated, no trailing slash.
# Defaults to the Vite dev origins (http://localhost:5173) outside production.
CORS_ORIGIN=

# ---- Optional
PORT=3000
NODE_ENV=development
# Refresh cookie SameSite mode is detected automatically; override with strict | lax | none
# REFRESH_COOKIE_SAMESITE=

# Redis (BullMQ email queue, cache). If REDIS_PASSWORD is set here, set the same
# value in the shell before `docker-compose up` so the local Redis requires it.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_FROM_NAME=SaLuDo
APP_URL=http://localhost:5173
APP_NAME=SaLuDo
DAILY_DIGEST_TIME=
WEEKLY_DIGEST_TIME=
